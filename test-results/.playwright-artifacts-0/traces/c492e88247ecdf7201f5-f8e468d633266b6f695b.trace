xl"},"Ethical conduct"],["DD",{"class":"max-w-[58ch] text-sm leading-6 text-adesa-300 sm:text-base sm:leading-7"},"Zero tolerance for corruption, fraud, conflicts of interest, or conduct that compromises stakeholder trust. Supported by anti-corruption policies, reporting channels, and protected escalation."]],["DIV",{"class":"grid gap-4 border-b border-white/12 py-7 sm:grid-cols-[3rem_minmax(10rem,0.7fr)_1.3fr] sm:gap-7 sm:py-9"},["SPAN",{"class":"text-xs tabular-nums text-gold-300","aria-hidden":"true"},"02"],["DT",{"class":"text-lg font-medium text-adesa-50 sm:text-xl"},"Transparency and reporting"],["DD",{"class":"max-w-[58ch] text-sm leading-6 text-adesa-300 sm:text-base sm:leading-7"},"Clear financial, operational, and stakeholder reporting against established standards, with audit compliance and visible accountability."]],["DIV",{"class":"grid gap-4 border-b border-white/12 py-7 sm:grid-cols-[3rem_minmax(10rem,0.7fr)_1.3fr] sm:gap-7 sm:py-9"},["SPAN",{"class":"text-xs tabular-nums text-gold-300","aria-hidden":"true"},"03"],["DT",{"class":"text-lg font-medium text-adesa-50 sm:text-xl"},"Board oversight"],["DD",{"class":"max-w-[58ch] text-sm leading-6 text-adesa-300 sm:text-base sm:leading-7"},"Board-level review keeps subsidiary strategy, performance, and material decisions aligned with group responsibilities."]],["DIV",{"class":"grid gap-4 border-b border-white/12 py-7 sm:grid-cols-[3rem_minmax(10rem,0.7fr)_1.3fr] sm:gap-7 sm:py-9"},["SPAN",{"class":"text-xs tabular-nums text-gold-300","aria-hidden":"true"},"04"],["DT",{"class":"text-lg font-medium text-adesa-50 sm:text-xl"},"Regulatory compliance"],["DD",{"class":"max-w-[58ch] text-sm leading-6 text-adesa-300 sm:text-base sm:leading-7"},"Operations are expected to meet applicable legal, tax, labour, industry, and jurisdictional requirements."]]]]],["SECTION",{"class":"section-space bg-adesa-950 text-adesa-100","aria-labelledby":"oversight-cycle-title"},["DIV",{"class":"site-container grid gap-12 lg:grid-cols-