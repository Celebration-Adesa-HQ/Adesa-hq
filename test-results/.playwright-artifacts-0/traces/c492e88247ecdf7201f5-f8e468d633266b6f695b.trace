a-labelledby":"about-origin-title"},["DIV",{"class":"site-container grid items-start gap-12 lg:grid-cols-12 lg:gap-16"},["DIV",{"class":"lg:col-span-6","style":"opacity:0;transform:translateY(24px)"},["P",{"class":"text-sm font-semibold text-gold-300"},"Origin and purpose"],["H2",{"id":"about-origin-title","class":"mt-5 max-w-[14ch] text-4xl font-medium leading-[1.04] tracking-[-0.045em] text-adesa-50 sm:text-5xl lg:text-6xl"},"Built beyond the investment thesis."],["DIV",{"class":"mt-8 max-w-[62ch] space-y-6 text-base leading-8 text-adesa-300"},["P",{},"ADESA HQ was established on a conviction that Africa’s critical sectors require enterprises built for decades, not opportunistic exits."],["P",{},"We are active builder-operators who conceive, launch, govern, and strengthen businesses with the patience that lasting institutions demand."],["P",{},"Our model connects hands-on operating leadership with holding-company governance, giving each subsidiary both practical support and uncompromised standards."]]],["DIV",{"class":"lg:col-span-5 lg:col-start-8 lg:pt-14","style":"opacity:0;transform:translateY(24px)"},["FIGURE",{"class":"border-l border-gold-400/60 pl-4 sm:pl-6"},["DIV",{"class":"relative aspect-[6/5] overflow-hidden bg-adesa-950"},["IMG",{"__playwright_current_src__":"http://127.0.0.1:3000/_next/image?url=%2Flegacy-in-motion-story.webp&w=384&q=75","alt":"Legacy in Motion artwork presenting the ADESA HQ group","loading":"lazy","decoding":"async","data-nimg":"fill","class":"object-cover","style":"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent","sizes":"(max-width: 1023px) 92vw, 42vw","srcset":"/_next/image?url=%2Flegacy-in-motion-story.webp&w=384&q=75 384w, /_next/image?url=%2Flegacy-in-motion-story.webp&w=640&q=75 640w, /_next/image?url=%2Flegacy-in-motion-story.webp&w=750&q=75 750w, /_next/image?url=%2Flegacy-in-motion-story.webp&w=828&q=75 828w, /_next/image?url=%2Flegacy-in-motion-story.webp&w=1080&q=75 1080w, /_next