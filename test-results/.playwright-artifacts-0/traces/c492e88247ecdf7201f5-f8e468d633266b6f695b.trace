{"type":"after","callId":"call@40","endTime":20285.296,"result":{"value":{"a":[{"s":"{\"@context\":\"https://schema.org\",\"@type\":\"Organization\",\"@id\":\"https://www.adesahq.com#organization\",\"name\":\"ADESA HQ\",\"legalName\":\"ADESA HQ\",\"url\":\"https://www.adesahq.com\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://www.adesahq.com/Adesa%20HQ%20new%20look%20secondary.png\",\"contentUrl\":\"https://www.adesahq.com/Adesa%20HQ%20new%20look%20secondary.png\",\"caption\":\"ADESA HQ logo\"},\"image\":[\"https://www.adesahq.com/Adesa%20HQ%20new%20look%20secondary.png\",\"https://www.adesahq.com/opengraph-image\"],\"description\":\"ADESA HQ is a governance-led holding group that conceives, launches, and strengthens enduring African businesses across priority sectors.\",\"slogan\":\"Legacy in Motion\",\"foundingDate\":\"2021\",\"award\":\"Best Multi-Sector Business Group 2026\",\"email\":\"info@adesahq.com\",\"telephone\":\"+234 701 2345 154\",\"areaServed\":[{\"@type\":\"Country\",\"name\":\"Nigeria\"},{\"@type\":\"Place\",\"name\":\"Africa\"}],\"knowsAbout\":[\"Corporate governance\",\"Capital allocation\",\"Institution building\",\"Media and creative services\",\"Renewable energy infrastructure\",\"Business systems\",\"Distribution and supply chain\"],\"sameAs\":[\"https://twitter.com/adesahq\",\"https://linkedin.com/company/adesa-hq\",\"https://www.instagram.com/adesasolution?igsh=YTU2ZnFhYTNvZTll&utm_source=qr\"],\"contactPoint\":[{\"@type\":\"ContactPoint\",\"contactType\":\"general enquiries\",\"email\":\"info@adesahq.com\",\"telephone\":\"+234 701 2345 154\",\"areaServed\":\"NG\",\"availableLanguage\":[\"en\"]}],\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"2 Isheri Road, Ojudu-Berger\",\"addressLocality\":\"Lagos\",\"addressCountry\":\"NG\"},\"subOrganization\":[{\"@type\":\"Organization\",\"name\":\"Adesa Media\",\"description\":\"A full-spectrum media and creative services company delivering strategic communications, brand development, and content production for leading organizations across Africa.\",\"url\":\"https://www.adesamedia.com/\",\"parentOrganization\":{\"@id\":\"https://www.adesahq.com#organization\"}},{\"@type\":\"Organization\",\"name\":\"Adesa Energy\",\"description\":\"Focused on renewable power solutions and critical infrastructure development to support sustainable growth across African markets.\",\"url\":\"https://www.adesaenergy.com/\",\"parentOrganization\":{\"@id\":\"https://www.adesahq.com#organization\"}},{\"@type\":\"Organization\",\"name\":\"Adesa Solutions\",\"description\":\"A solutions-led arm focused on practical systems, execution support, and operational problem solving across the ADESA group.\",\"url\":\"https://www.instagram.com/adesasolution?igsh=YTU2ZnFhYTNvZTll&utm_source=qr\",\"parentOrganization\":{\"@id\":\"https://www.adesahq.com#organization\"}},{\"@type\":\"Organization\",\"name\":\"Adesa Distribution\",\"description\":\"A market access, distribution, and supply chain company connecting manufacturers and suppliers with retailers, institutions, and consumers across Africa.\",\"url\":\"https://www.instagram.com/adesadistribution?igsh=MTM0c3BvajlxaW80bg%3D%3D&utm_source=qr\",\"parentOrganization\":{\"@id\":\"https://www.adesahq.com#organization\"}}]}"},{"s":"{\"@context\":\"https://schema.org\",\"@type\":\"WebSite\",\"@id\":\"https://www.adesahq.com#website\",\"url\":\"https://www.adesahq.com\",\"name\":\"ADESA HQ\",\"alternateName\":\"ADESA\",\"description\":\"ADESA HQ is a governance-led holding group that conceives, launches, and strengthens enduring African businesses across priority sectors.\",\"publisher\":{\"@id\":\"https://www.adesahq.com#organization\"},\"about\":{\"@id\":\"https://www.adesahq.com#organization\"},\"inLanguage\":\"en-NG\"}"},{"s":"{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"WebPage\",\"@id\":\"https://www.adesahq.com#webpage\",\"url\":\"https://www.adesahq.com\",\"name\":\"ADESA HQ\",\"headline\":\"ADESA HQ | B