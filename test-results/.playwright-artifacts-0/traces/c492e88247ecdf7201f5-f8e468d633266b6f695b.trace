{"type":"after","callId":"call@142","endTime":33952.202,"result":{"value":{"a":[{"s":"{\"@context\":\"https://schema.org\",\"@type\":\"Organization\",\"@id\":\"https://www.adesahq.com#organization\",\"name\":\"ADESA HQ\",\"legalName\":\"ADESA HQ\",\"url\":\"https://www.adesahq.com\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://www.adesahq.com/Adesa%20HQ%20new%20look%20secondary.png\",\"contentUrl\":\"https://www.adesahq.com/Adesa%20HQ%20new%20look%20secondary.png\",\"caption\":\"ADESA HQ logo\"},\"image\":[\"https://www.adesahq.com/Adesa%20HQ%20new%20look%20secondary.png\",\"https://www.adesahq.com/opengraph-image\"],\"description\":\"ADESA HQ is a governance-led holding group that conceives, launches, and strengthens enduring African businesses across priority sectors.\",\"slogan\":\"Legacy in Motion\",\"foundingDate\":\"2021\",\"award\":\"Best Multi-Sector Business Group 2026\",\"email\":\"info@adesahq.com\",\"telephone\":\"+234 701 2345 154\",\"areaServed\":[{\"@type\":\"Country\",\"name\":\"Nigeria\"},{\"@type\":\"Place\",\"name\":\"Africa\"}],\"knowsAbout\":[\"Corporate governance\",\"Capital allocation\",\"Institution building\",\"Media and creative services\",\"Renewable energy infrastructure\",\"Business systems\",\"Distribution and supply chain\"],\"sameAs\":[\"https://twitter.com/adesahq\",\"https://linkedin.com/company/adesa-hq\",\"https://www.instagram.com/adesasolution?igsh=YTU2ZnFhYTNvZTll&utm_source=qr\"],\"contactPoint\":[{\"@type\":\"ContactPoint\",\"contactType\":\"general enquiries\",\"email\":\"info@adesahq.com\",\"telephone\":\"+234 701 2345 154\",\"areaServed\":\"NG\",\"availableLanguage\":[\"en\"]}],\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"2 Isheri Road, Ojudu-Berger\",\"addressLocality\":\"Lagos\",\"addressCountry\":\"NG\"},\"subOrganization\":[{\"@type\":\"Organization\",\"name\":\"Adesa Media\",\"description\":\"A full-spectrum media and creative services company delivering strategic communications, brand develo